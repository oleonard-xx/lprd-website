# Copiază în .env și completează. Nimic de aici nu este obligatoriu pentru rularea locală.

PORT=3000
# URL-ul public al site-ului (folosit în linkurile din emailuri și în canonical).
BASE_URL=http://localhost:3000
# production activează HSTS și cookie-uri Secure.
NODE_ENV=development

# Parola pentru /admin. Dacă lipsește, la prima pornire se generează una și se afișează în consolă.
# ADMIN_PASSWORD=

# Secret pentru semnarea linkurilor din emailuri (dezabonare, confirmări).
# Dacă lipsește, se generează automat în data/secret.key.
# APP_SECRET=

# Trimitere emailuri reale prin SMTP (necesită: npm install nodemailer).
# Fără SMTP_URL, emailurile sunt salvate ca fișiere .eml în data/outbox/.
# SMTP_URL=smtps://utilizator:parola@smtp.furnizor.ro:465
# MAIL_FROM="LPRD <contact@domeniul-tau.ro>"

# Setează 1 doar dacă serverul rulează în spatele unui reverse proxy (nginx, Caddy)
# care adaugă antetul X-Forwarded-For. Altfel limitarea de cereri poate fi ocolită.
# TRUST_PROXY=1
